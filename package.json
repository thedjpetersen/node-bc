{
  "name": "node-bc",
  "version": "2.0.0",
  "description": "Modern TypeScript wrapper for the BiblioCommons library system API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "bibliocommons",
    "library",
    "books",
    "api",
    "wrapper",
    "typescript"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedjpetersen/node-bc.git"
  },
  "author": "David Petersen <davjpetersen@gmail.com> (http://thedjpetersen.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thedjpetersen/node-bc/issues"
  },
  "homepage": "https://github.com/thedjpetersen/node-bc#readme",
  "dependencies": {
    "axios": "^1.6.2",
    "axios-cookiejar-support": "^5.0.2",
    "cheerio": "^1.0.0-rc.12",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.3.3"
